#!/bin/sh
# H5000M install default (uci-defaults, first boot): wps button coexistence handler.
#
# Defect fixed 2026-11-18: the previous bake wrote ONLY /etc/rc.button/wps, but
# S99Airpifanctrl does `cp /usr/bin/wps /etc/rc.button/wps` on every start/restart,
# clobbering the override with the vendor fan handler each boot. Fix: install the
# handler at the SOURCE /usr/bin/wps (what Airpifanctrl copies) so it propagates on
# every boot, and seed /etc/rc.button/wps too. The real fan daemon /usr/bin/fancts.sh
# and LuCI fan control are untouched; only the button shortcut is repurposed.
#
# Coexistence: SHORT press (released SEEN<3) = vendor fan-boost toggle (max<->smart);
# LONG press (released SEEN>=3) = eth1 LAN<->WAN toggle via /usr/bin/eth1-{lan,wan}.sh
# (8s cooldown, white:wan LED blink, auto-rollback). reset button untouched.
# No secrets baked (config/logic only).
cat > /usr/bin/wps <<'WPSHANDLER'
#!/bin/sh
# H5000M wps button — coexistence handler (2026-11-18 defect fix).
#   SHORT press (released SEEN<3)  : vendor fan-boost toggle (max cooling <-> smart).
#   LONG  press (released SEEN>=3) : eth1 LAN<->WAN toggle (proven eth1-{lan,wan}.sh).
#
# Why this file lives at /usr/bin/wps: S99Airpifanctrl does
#   cp /usr/bin/wps /etc/rc.button/wps
# on every start/restart, which clobbered the old uci-defaults-only override.
# Installing the handler at the SOURCE (/usr/bin/wps) makes Airpifanctrl propagate
# it on every boot. The real fan daemon /usr/bin/fancts.sh and LuCI fan control are
# untouched; only the button shortcut is repurposed. reset button is untouched.
#
# Fan-boost toggle has NO cooldown so rapid short presses work (boost <-> normal),
# matching the vendor behaviour. The eth1 toggle keeps an 8s cooldown because a
# network reload blips ALL LAN (incl. eth0) ~15-25s.
#
# Invoked by procd button hotplug (sourced): ACTION=pressed|released|timeout,
# SEEN=hold seconds (proven delivered by /etc/rc.button/reset on this firmware).
# Uses `return` (sourced context), never `exit`.
# WPS_DRY_RUN=1 => log only; no fan curl, no uci/reload, no LED write.

TAG="wps-toggle"
FANCONF="/tmp/wpsbt.conf"
LOCK="/tmp/.wps-toggle.lock"
LOGDIR="/root/h5000m-wps"
COOLDOWN=8
THRESHOLD=3
LED="/sys/class/leds/white:wan"
DRY="${WPS_DRY_RUN:-0}"

log() {
	logger -t "$TAG" "$*"
	mkdir -p "$LOGDIR" 2>/dev/null
	echo "$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || date) $*" >> "$LOGDIR/toggle.log"
}

fan_boost() {
	ts=$(date +%s)
	if [ ! -f "$FANCONF" ]; then
		if [ "$DRY" = "1" ]; then
			log "DRY_RUN short press -> would fan-boost ON (max cooling); no change"
			return 0
		fi
		touch "$FANCONF"
		curl -s --max-time 3 "http://127.0.0.1/cgi-bin/luci/admin/fancontrol/fanst3?set=fanst3&p=1&ts=$ts"
		echo "팬 부스트 켜짐 (최대 냉각)" > /tmp/lucimsg.file
		log "FAN boost ON (short press, max cooling)"
	else
		if [ "$DRY" = "1" ]; then
			log "DRY_RUN short press -> would fan-boost OFF (smart); no change"
			return 0
		fi
		rm -f "$FANCONF"
		curl -s --max-time 3 "http://127.0.0.1/cgi-bin/luci/admin/fancontrol/fanst4?set=fanst4&p=1&ts=$ts"
		echo "팬 부스트 꺼짐 (스마트 모드)" > /tmp/lucimsg.file
		log "FAN boost OFF (short press, smart mode)"
	fi
}

now=$(date +%s)
case "$ACTION" in
pressed)
	return 0
	;;
released)
	if [ "${SEEN:-0}" -lt "$THRESHOLD" ]; then
		fan_boost
		return 0
	fi
	;;
*)
	return 0
	;;
esac

# ---- long press >=3s: eth1 LAN<->WAN toggle (8s cooldown debounce) ----
if [ -f "$LOCK" ]; then
	last=$(cat "$LOCK" 2>/dev/null || echo 0)
	if [ $((now - last)) -lt "$COOLDOWN" ]; then
		log "IGNORE cooldown ($((now - last))s < ${COOLDOWN}s)"
		return 0
	fi
fi

if [ -e /sys/class/net/br-lan/brif/eth1 ]; then
	CUR="LAN"; TARGET="WAN"; SCRIPT="/usr/bin/eth1-wan.sh"
else
	CUR="WAN"; TARGET="LAN"; SCRIPT="/usr/bin/eth1-lan.sh"
fi

if [ "$DRY" = "1" ]; then
	log "DRY_RUN long press eth1 current=$CUR would-toggle-to=$TARGET via=$SCRIPT SEEN=${SEEN}s (no config change)"
	echo "$now" > "$LOCK"
	return 0
fi

echo "$now" > "$LOCK"
log "TOGGLE eth1 $CUR -> $TARGET (SEEN=${SEEN}s)"

# LED blink in background so the handler is not blocked; restore trigger after.
if [ -d "$LED" ]; then
	(
		old_trig=$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' "$LED/trigger" 2>/dev/null)
		old_dev=$(cat "$LED/device_name" 2>/dev/null)
		echo none > "$LED/trigger" 2>/dev/null
		i=0
		while [ "$i" -lt 3 ]; do
			echo 1 > "$LED/brightness" 2>/dev/null; sleep 1
			echo 0 > "$LED/brightness" 2>/dev/null; sleep 1
			i=$((i + 1))
		done
		if [ "$old_trig" = "netdev" ] && [ -n "$old_dev" ]; then
			echo netdev > "$LED/trigger" 2>/dev/null
			echo "$old_dev" > "$LED/device_name" 2>/dev/null
		else
			echo "${old_trig:-none}" > "$LED/trigger" 2>/dev/null
		fi
	) >/dev/null 2>&1 &
fi

if [ -x "$SCRIPT" ]; then
	"$SCRIPT"
	log "DISPATCHED $SCRIPT (reload blips LAN ~15-25s; auto-rollback on verify fail)"
else
	log "ERROR $SCRIPT not found/executable"
fi
return 0
WPSHANDLER
chmod 755 /usr/bin/wps
cp /usr/bin/wps /etc/rc.button/wps
chmod 755 /etc/rc.button/wps
exit 0
