From 4b2b2f555a4cac553b66282718e49109a55d6c12 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Uwe=20Kleine-K=C3=B6nig?= <u.kleine-koenig@baylibre.com>
Date: Mon, 28 Jul 2025 18:00:18 +0200
Subject: [PATCH] pwm: mediatek: Fix duty and period setting
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

commit f21d136caf8171f94159d975ea4620c164431bd9 upstream.

The period generated by the hardware is

	(PWMDWIDTH + 1) << CLKDIV) / freq

according to my tests with a signal analyser and also the documentation.

The current algorithm doesn't consider the `+ 1` part and so configures
slightly too high periods. The same issue exists for the duty cycle
setting. So subtract 1 from both the register values for period and
duty cycle. If period is 0, bail out, if duty_cycle is 0, just disable
the PWM which results in a constant low output.

Fixes: caf065f8fd58 ("pwm: Add MediaTek PWM support")
Signed-off-by: Uwe Kleine-König <u.kleine-koenig@baylibre.com>
Reviewed-by: AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
Link: https://lore.kernel.org/r/6d1fa87a76f8020bfe3171529b8e19baffceab10.1753717973.git.u.kleine-koenig@baylibre.com
Cc: stable@vger.kernel.org
Signed-off-by: Uwe Kleine-König <ukleinek@kernel.org>
Signed-off-by: Greg Kroah-Hartman <gregkh@linuxfoundation.org>

Backport note (H5000M rebase-v2, 3/3):
- Source: linux-6.6.y stable 747977aeefd4, the actual duty/period fix.
  Requires 999-2137 (ad9d4db5a8ac) and 999-2138 (070236488cc9) first.
- Rebased onto the FULL downstream pwm-mediatek chain (806-mt7988,
  999-2133-longer-period, 999-2135-mt7987, 999-2136-hw-breathing-light).
  The canonical stable patch FAILS on that base (hunks #1/#2: 999-2136
  replaced the 8191 loop bound with max_cnt_period and restructured the
  PWMDWIDTH/PWMTHRES write region). The previous rebased version that
  only covered up to 999-2133 also FAILS (2/3 hunks) on the real build
  state; this version supersedes it.
- Adaptations vs the canonical stable commit (all intentional):
  * Loop bound: "while (cnt_period > max_cnt_period + 1)" instead of
    "> 8192", so the off-by-one correction also respects the 999-2136
    breathing-mode 255 cap (max_cnt_period is 8191 or 255).
  * !cnt_period guard uses "ret = -EINVAL; goto out;" instead of the
    upstream bare "return -EINVAL", which would leak the enabled clock
    (config enables clocks at entry in this 6.6 backport). Consistent
    with the unified error paths of 999-2137.
  * 999-2136 breathing-light branch preserved: in bw_mode the threshold
    array is still programmed via pwm_config_bl_thres(cnt_period) and
    the PWM is enabled there (999-2139 removes the hw-enable from
    pwm_mediatek_apply(), so config must enable it, otherwise breathing
    mode would never start). Normal mode follows upstream: duty > 0 ->
    PWMTHRES = cnt_duty - 1 and enable; duty == 0 -> disable (constant
    low). PWMDWIDTH = cnt_period - 1 in both modes; the 999-2133 clksel
    PWMCON if/else is preserved unchanged.
- Apply order: 999-2137 -> 999-2138 -> 999-2139 (this patch is 999-2139).
---
 drivers/pwm/pwm-mediatek.c | 25 ++++++++++++++++---------
 1 file changed, 16 insertions(+), 9 deletions(-)

diff --git a/drivers/pwm/pwm-mediatek.c b/drivers/pwm/pwm-mediatek.c
index ea68165..3d9b91a 100644
--- a/drivers/pwm/pwm-mediatek.c
+++ b/drivers/pwm/pwm-mediatek.c
@@ -275,7 +275,12 @@ static int pwm_mediatek_config(struct pwm_chip *chip, struct pwm_device *pwm,
 	 */
 	cnt_period = DIV_ROUND_CLOSEST_ULL((u64)period_ns * 1000, resolution);
 
-	while (cnt_period > max_cnt_period) {
+	if (!cnt_period) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	while (cnt_period > max_cnt_period + 1) {
 		/* Using clkdiv to reduce clock frequency and calculate
 		 * new resolution based on new clock speed
 		 */
@@ -320,13 +325,18 @@ static int pwm_mediatek_config(struct pwm_chip *chip, struct pwm_device *pwm,
 	else
 		pwm_mediatek_writel(pc, pwm->hwpwm, PWMCON, BIT(15) | clkdiv);
 
-	pwm_mediatek_writel(pc, pwm->hwpwm, reg_width, cnt_period);
+	pwm_mediatek_writel(pc, pwm->hwpwm, reg_width, cnt_period - 1);
 
 	/* use array of bw_thres instead of normal thres in bw_mode */
-	if (pc->bw_mode[pwm->hwpwm])
+	if (pc->bw_mode[pwm->hwpwm]) {
 		pwm_config_bl_thres(pc, pwm->hwpwm, cnt_period, thres_num);
-	else
-		pwm_mediatek_writel(pc, pwm->hwpwm, reg_thres, cnt_duty);
+		pwm_mediatek_enable(chip, pwm);
+	} else if (cnt_duty) {
+		pwm_mediatek_writel(pc, pwm->hwpwm, reg_thres, cnt_duty - 1);
+		pwm_mediatek_enable(chip, pwm);
+	} else {
+		pwm_mediatek_disable(chip, pwm);
+	}
 
 out:
 	pwm_mediatek_clk_disable(chip, pwm);
@@ -355,11 +365,8 @@ static int pwm_mediatek_apply(struct pwm_chip *chip, struct pwm_device *pwm,
 	if (err)
 		return err;
 
-	if (!pwm->state.enabled) {
+	if (!pwm->state.enabled)
 		err = pwm_mediatek_clk_enable(chip, pwm);
-		if (!err)
-			pwm_mediatek_enable(chip, pwm);
-	}
 
 	return err;
 }
